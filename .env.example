# Copie para .env.local (não versionado) e ajuste. Em produção, configure estas
# variáveis no painel do Cloudflare Pages (Settings → Variables and Secrets).

# --- Navegador (lida no build; precisa do prefixo VITE_) ---
# Site key do Cloudflare Turnstile. Sem ela, o `yarn dev` usa a chave de teste.
VITE_TURNSTILE_SITE_KEY=

# --- Servidor (functions/api/contato.js) ---
# Secret key do Turnstile. Sem ela, o `yarn dev` usa a chave de teste; em produção o envio é recusado.
TURNSTILE_SECRET_KEY=

# "true" para enviar e-mails de verdade. Qualquer outro valor = modo teste (nada é enviado).
CONTATO_ENVIAR_EMAIL=false

# Usadas só quando CONTATO_ENVIAR_EMAIL=true (envio via https://resend.com)
RESEND_API_KEY=
# Remetente num domínio verificado no Resend, ex.: Site EGRIC <contato@seudominio.org.br>
CONTATO_EMAIL_REMETENTE=
# Padrão: egric.espeleogrupo@gmail.com
CONTATO_EMAIL_DESTINO=

# Opcional: origens aceitas, separadas por vírgula. Padrão: a própria origem do site.
ALLOWED_ORIGINS=
